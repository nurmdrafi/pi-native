{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "theme": "dark",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "max",
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "off",
    "deepseek/deepseek-v4-pro": "off"
  },
  "hideThinkingBlock": true,
  "defaultTools": [
    "-read",
    "-write",
    "-edit",
    "-bash"
  ],
  "packages": [],
  "compaction": {
    "modelOverrides": {
      "zai/glm-5.3": {
        "reserveTokens": 845000
      }
    }
  },
  "extensions": [
    "-builtin:mcp"
  ]
}