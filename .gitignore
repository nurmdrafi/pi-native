skills-archive.tar.gz

# Removed (git-only sync; no scripts)
setup.sh
bundle.sh
__pycache__/

# Transient locks
*.lock
# ...but the Rust workspace lockfile is a build input (reproducible binaries)
!custom-tools/Cargo.lock
tavily/config.json
tavily/session.json
# Machine-local gate telemetry (violation-memory counts)
logs/
# Autoresearch per-session scratch (workingDir pointer, rewritten each run)
.auto/
