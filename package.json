{
 "name": "pi-native",
 "private": true,
 "type": "module",
 "scripts": {
  "prepare": "husky",
  "bootstrap": "sh scripts/bootstrap.sh",
  "after-pull": "sh scripts/after-pull.sh",
  "link-pi": "node scripts/link-pi.mjs",
  "typecheck": "node scripts/link-pi.mjs && tsc -p tsconfig.json",
  "test": "node --test \"tests/**/*.test.mjs\"",
  "test:subagents": "node --test tests/subagents/test.ts",
  "lint:agents": "node scripts/agents-lint.mjs",
  "doc:check": "node scripts/doc-check.mjs",
  "gate:eval": "node scripts/gate-eval.mjs",
  "daemons:kill": "pkill -f \"$(dirname \"$npm_package_json\")/bin/(pibash|piread|piedit) --serve\" || true",
  "bench:model-visible": "node tests/model-visible-baseline.mjs",
  "bench:model-visible:compare": "node tests/model-visible-baseline.mjs --compare",
  "bench:model-visible:update": "node tests/model-visible-baseline.mjs --update",
  "check": "npm run typecheck && npm run lint:agents && npm run doc:check && npm test"
 },
 "devDependencies": {
  "@commitlint/cli": "^19.6.1",
  "@commitlint/config-conventional": "^19.6.1",
  "@sinclair/typebox": "^0.34.49",
  "@types/node": "^26.4.1",
  "husky": "^9.1.7",
  "typescript": "^7.0.2"
 }
}
