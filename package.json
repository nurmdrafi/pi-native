{
  "name": "pi-native",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "bootstrap": "sh scripts/bootstrap.sh",
    "after-pull": "sh scripts/after-pull.sh",
    "link-pi": "node scripts/link-pi.mjs",
    "typecheck": "node scripts/link-pi.mjs && tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\" \"dashboard/tests/**/*.test.mjs\"",
    "test:subagents": "node --test tests/subagents/runner.ts 'tests/subagents/*.test.ts'",
    "lint:agents": "node scripts/agents-lint.mjs",
    "doc:check": "~/.pi/agent/bin/docheck",
    "gate:eval": "node tests/gate/eval/run.mjs",
    "daemons:kill": "pkill -f \"$(dirname \"$npm_package_json\")/bin/(pibash|piread|piedit) --serve\" || true",
    "bench:model-visible": "node tests/tools/bench/model-visible-baseline.mjs",
    "bench:model-visible:compare": "node tests/tools/bench/model-visible-baseline.mjs --compare",
    "bench:model-visible:update": "node tests/tools/bench/model-visible-baseline.mjs --update",
    "bench:piread": "node tests/tools/bench/piread.mjs",
    "bench:pibash": "node tests/tools/bench/pibash.mjs",
    "bench:piedit": "node tests/tools/bench/piedit.mjs",
    "check": "npm run typecheck && npm run lint:agents && npm run doc:check && npm test",
    "audit:session": "node tests/tools/audit/session-blocks.mjs",
    "audit:bin-diff": "node tests/tools/audit/bin-diff.mjs",
    "dashboard": "node dashboard/scripts/dashboard.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "@earendil-works/pi-ai": "^1.4.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
