{
  "$schema": "./config.schema.json",
  "_comment": "Permission-gate rule switches. Set a rule to false to disable it. Rule IDs (R1, P3, ...) are the internal cross-reference used in source comments and the README rule table; the keys here are the stable, human-readable names. Env overrides: PGATE_<KEY>=0 disables one rule for a single run without editing this file. Inert rules stay inert regardless of the value (see each rule's README row).",

  "rules": {
    "editAnchorGuard": true,
    "reReadGuard": true,
    "largeReadGuard": true,
    "locateFirst": true,
    "nativeReadFirst": true,
    "nativeBashFirst": true,
    "nativeToolsInScripts": true,
    "codemodeScriptGuard": true,
    "outputCap": true,
    "readOutputCap": true,
    "destructiveConfirm": true,
    "commitMessageLint": true,
    "rerunGuard": true,
    "reblockEscalation": true,
    "toolchainPnpm": true,
    "toolchainNode": true,
    "searchScope": true,
    "searchMidPipe": true,
    "findFirst": true,
    "searchPortability": true,
    "dependencyInternals": true,
    "violationMemory": true,
    "adoptionTelemetry": true,
    "cadenceNudge": true,
    "outputScrub": true
  },

  "outputCap": {
    "maxLines": 40,
    "maxBytes": 2048
  },

  "confirm": {
    "timeoutMs": 300000
  },

  "violationMemory": {
    "distinctSessionsBeforeLesson": 5,
    "windowDays": 30
  }
}
